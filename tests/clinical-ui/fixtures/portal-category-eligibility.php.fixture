        'queries' => \OpenEMR\Services\AppointmentService::$queries,
        'inputCalls' => \PortalCategoryEligibilityFixture\InputBoundary::$calls,
        'post' => (object) $_POST,
        'output' => $output,
        'exitTerminations' => $exitTokens,
