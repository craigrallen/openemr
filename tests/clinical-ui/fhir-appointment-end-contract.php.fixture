<?php

declare(strict_types=1);

// This fixture loads the complete native appointment parser, R4 model hierarchy,
// date utility, service traits and interfaces. Only its framework parent is
// synthetic: constructor/search/DB behavior is outside this read contract.
namespace OpenEMR\Services\FHIR {
    class FhirServiceBase {}
}

namespace {
    use OpenEMR\FHIR\R4\FHIRDomainResource\FHIRAppointment;
    use OpenEMR\Services\FHIR\FhirAppointmentService;

    $root = dirname(__DIR__, 2);
    spl_autoload_register(static function (string $class) use ($root): void {
        if (!str_starts_with($class, 'OpenEMR\\')) {
            return;
        }
        $path = $root . '/src/' . str_replace('\\', '/', substr($class, strlen('OpenEMR\\'))) . '.php';
        if (is_file($path)) {
            require_once $path;
        }
    });

    require_once $root . '/src/Services/FHIR/FhirAppointmentService.php';
    if ((new ReflectionClass(FhirAppointmentService::class))->getFileName() !== $root . '/src/Services/FHIR/FhirAppointmentService.php') {
        throw new RuntimeException('Native appointment service was not loaded');
    }
    if ((new ReflectionClass(FHIRAppointment::class))->getFileName() !== $root . '/src/FHIR/R4/FHIRDomainResource/FHIRAppointment.php'
        || (new ReflectionClass(\OpenEMR\FHIR\R4\FHIRElement\FHIRInstant::class))->getFileName() !== $root . '/src/FHIR/R4/FHIRElement/FHIRInstant.php'
        || (new ReflectionClass(\OpenEMR\Services\FHIR\UtilsService::class))->getFileName() !== $root . '/src/Services/FHIR/UtilsService.php') {
        throw new RuntimeException('Native FHIR model or date utility was not loaded');
    }
    $service = (new ReflectionClass(FhirAppointmentService::class))->newInstanceWithoutConstructor();

    $base = [
        'pc_uuid' => '11111111-1111-4111-8111-111111111111',
        'pc_time' => '2026-01-01 12:00:00',
        'pc_apptstatus' => 'SMS',
        'pc_catid' => null,
        'puuid' => null,
        'pce_aid_uuid' => null,
        'facility_uuid' => null,
        'pc_eventDate' => '2026-01-15',
        'pc_startTime' => '09:00:00',
        'pc_endTime' => '10:00:00',
        'pc_endDate' => null,
        'pc_duration' => 3600,
        'pc_hometext' => 'Keep this comment',
    ];

    // Expected instants are literal contract values, independent of today's date.
    $cases = [
        ['same day', 'UTC', [], '2026-01-15T09:00:00+00:00', '2026-01-15T10:00:00+00:00'],
        ['overnight', 'UTC', ['pc_startTime' => '23:30:00', 'pc_endTime' => '00:30:00'], '2026-01-15T23:30:00+00:00', '2026-01-16T00:30:00+00:00'],
        ['midnight', 'UTC', ['pc_startTime' => '23:00:00', 'pc_endTime' => '00:00:00'], '2026-01-15T23:00:00+00:00', '2026-01-16T00:00:00+00:00'],
        ['month rollover', 'UTC', ['pc_eventDate' => '2026-01-31', 'pc_startTime' => '23:30:00', 'pc_endTime' => '00:30:00'], '2026-01-31T23:30:00+00:00', '2026-02-01T00:30:00+00:00'],
        ['year rollover', 'UTC', ['pc_eventDate' => '2026-12-31', 'pc_startTime' => '23:30:00', 'pc_endTime' => '00:30:00'], '2026-12-31T23:30:00+00:00', '2027-01-01T00:30:00+00:00'],
        ['over 24 hours', 'UTC', ['pc_startTime' => '23:30:00', 'pc_endTime' => '00:30:00', 'pc_duration' => 90000], '2026-01-15T23:30:00+00:00', '2026-01-17T00:30:00+00:00'],
        ['zero duration', 'UTC', ['pc_startTime' => '09:00:00', 'pc_endTime' => '09:00:00', 'pc_duration' => 0], '2026-01-15T09:00:00+00:00', '2026-01-15T09:00:00+00:00'],
        ['numeric string duration', 'UTC', ['pc_startTime' => '23:30:00', 'pc_endTime' => '00:30:00', 'pc_duration' => '3600'], '2026-01-15T23:30:00+00:00', '2026-01-16T00:30:00+00:00'],
        ['missing duration fallback', 'UTC', ['pc_startTime' => '23:30:00', 'pc_endTime' => '00:30:00', 'pc_duration' => null], '2026-01-15T23:30:00+00:00', '2026-01-15T00:30:00+00:00'],
        ['invalid duration fallback', 'UTC', ['pc_startTime' => '23:30:00', 'pc_endTime' => '00:30:00', 'pc_duration' => 'unknown'], '2026-01-15T23:30:00+00:00', '2026-01-15T00:30:00+00:00'],
        ['negative duration fallback', 'UTC', ['pc_startTime' => '23:30:00', 'pc_endTime' => '00:30:00', 'pc_duration' => -3600], '2026-01-15T23:30:00+00:00', '2026-01-15T00:30:00+00:00'],
        ['missing date legacy', 'UTC', ['pc_eventDate' => null, 'pc_endDate' => '2026-03-20'], '2026-03-20T09:00:00+00:00', '2026-03-20T10:00:00+00:00'],
        ['missing end time legacy', 'UTC', ['pc_endTime' => null], '2026-01-15T09:00:00+00:00', null],
        ['recurrence end ignored', 'UTC', ['pc_endDate' => '2035-12-31', 'pc_startTime' => '23:30:00', 'pc_endTime' => '00:30:00'], '2026-01-15T23:30:00+00:00', '2026-01-16T00:30:00+00:00'],
        ['same day clock wins over duration mismatch', 'UTC', ['pc_duration' => 7200], '2026-01-15T09:00:00+00:00', '2026-01-15T10:00:00+00:00'],
        ['fixed offset overnight', 'Etc/GMT-2', ['pc_startTime' => '23:30:00', 'pc_endTime' => '00:30:00'], '2026-01-15T23:30:00+02:00', '2026-01-16T00:30:00+02:00'],
    ];

    $failures = [];
    foreach ($cases as [$name, $zone, $changes, $expectedStart, $expectedEnd]) {
        date_default_timezone_set($zone);
        $record = array_replace($base, $changes);
        $before = $record;
        try {
            $resource = $service->parseOpenEMRRecord($record);
            $actualStart = $resource->getStart()?->getValue();
            $actualEnd = $resource->getEnd()?->getValue();
            if (!$resource instanceof FHIRAppointment || $actualStart !== $expectedStart || $actualEnd !== $expectedEnd) {
                $failures[] = ['case' => $name, 'expected' => [$expectedStart, $expectedEnd], 'actual' => [$actualStart, $actualEnd]];
            }
            if ($record !== $before) {
                $failures[] = ['case' => $name, 'error' => 'input record mutated'];
            }
            if ($resource->getId()?->getValue() !== $base['pc_uuid']
                || $resource->getMeta()?->getVersionId() !== '1'
                || $resource->getMeta()?->getLastUpdated() !== ($zone === 'UTC' ? '2026-01-01T12:00:00+00:00' : '2026-01-01T12:00:00+02:00')
                || $resource->getStatus()?->getValue() !== 'booked'
                || $resource->getComment() !== 'Keep this comment') {
                $failures[] = ['case' => $name, 'error' => 'id/meta/status/comment changed'];
            }
        } catch (Throwable $error) {
            $failures[] = ['case' => $name, 'error' => get_class($error) . ': ' . $error->getMessage()];
        }
    }

    $result = $failures === []
        ? ['ok' => true, 'count' => count($cases)]
        : ['ok' => false, 'count' => count($cases), 'failures' => $failures];
    echo json_encode($result, JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR), "\n";
    exit($failures === [] ? 0 : 1);
}
