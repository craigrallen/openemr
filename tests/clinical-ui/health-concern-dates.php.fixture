<?php

declare(strict_types=1);

// Declaration only: the production parent initializes services and SQL state.
namespace OpenEMR\Services\FHIR {
    abstract class FhirServiceBase
    {
    }
}

namespace {
    use OpenEMR\FHIR\R4\FHIRDomainResource\FHIRCondition;
    use OpenEMR\Services\FHIR\Condition\FhirConditionHealthConcernService;

    if (PHP_SAPI !== 'cli') {
        exit(2);
    }

    ini_set('display_errors', '0');
    error_reporting(E_ALL);
    date_default_timezone_set('UTC');
    set_error_handler(static function (int $severity, string $message, string $file, int $line): never {
        throw new \ErrorException($message, 0, $severity, $file, $line);
    });

    function report(array $cases, int $exitCode): never
    {
        $passed = count(array_filter($cases, static fn(array $case): bool => $case['ok']));
        echo json_encode([
            'passed' => $passed,
            'failed' => count($cases) - $passed,
            'cases' => $cases,
        ], JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES), "\n";
        exit($exitCode);
    }

    function check(bool $condition, string $message): void
    {
        if (!$condition) {
            throw new \RuntimeException($message);
        }
    }

    function same(mixed $expected, mixed $actual, string $message): void
    {
        check($expected === $actual, $message . ': expected ' . var_export($expected, true) . ', received ' . var_export($actual, true));
    }

    function missing(array $document, string $key): void
    {
        check(!array_key_exists($key, $document), $key . ' must be absent');
    }

    function assertedDate(array $document): ?array
    {
        $matches = array_values(array_filter(
            $document['extension'] ?? [],
            static fn(array $extension): bool => ($extension['url'] ?? null) === 'http://hl7.org/fhir/StructureDefinition/condition-assertedDate'
        ));
        check(count($matches) <= 1, 'duplicate assertedDate extension');
        return $matches[0] ?? null;
    }

    function mapped(FhirConditionHealthConcernService $service, array $row, bool $encode = false): array
    {
        $resource = $service->parseOpenEMRRecord($row, $encode);
        if ($encode) {
            check(is_string($resource), 'encoded mapper result must be JSON text');
            return json_decode($resource, true, 512, JSON_THROW_ON_ERROR);
        }
        check($resource instanceof FHIRCondition, 'mapper must return the native FHIRCondition');
        return json_decode(json_encode($resource, JSON_THROW_ON_ERROR), true, 512, JSON_THROW_ON_ERROR);
    }

    $cases = [];
    $run = static function (string $name, callable $test) use (&$cases): void {
        try {
            $test();
            $cases[] = ['name' => $name, 'ok' => true, 'error' => null];
        } catch (\Throwable $error) {
            $cases[] = ['name' => $name, 'ok' => false, 'error' => $error->getMessage()];
        }
    };

    try {
        $root = dirname(__DIR__, 2);
        $servicePath = $root . '/src/Services/FHIR/Condition/FhirConditionHealthConcernService.php';
        $source = file_get_contents($servicePath);
        check(is_string($source), 'native service source is unreadable');

        spl_autoload_register(static function (string $class) use ($root): void {
            $prefix = 'OpenEMR\\';
            if (!str_starts_with($class, $prefix)) {
                return;
            }
            $relative = str_replace('\\', '/', substr($class, strlen($prefix))) . '.php';
            foreach ([$root . '/src/' . $relative, $root . '/library/' . $relative] as $candidate) {
                if (is_file($candidate)) {
                    require_once $candidate;
                    return;
                }
            }
        });

        $reflection = new \ReflectionClass(FhirConditionHealthConcernService::class);
        check($reflection->getFileName() === $servicePath, 'service must load from the native source path');
        $service = $reflection->newInstanceWithoutConstructor();
        $methodStart = strpos($source, 'protected function searchForOpenEMRRecords(');
        check($methodStart !== false, 'native search method is missing');
        $methodEnd = strpos($source, 'private function computeVerificationStatus(', $methodStart);
        check($methodEnd !== false, 'native search method boundary is missing');
        $searchSource = substr($source, $methodStart, $methodEnd - $methodStart);

        $legacyLine = "            l.date AS condition_date,\n";
        $addedLine = "            l.date AS date,\n";
        $hasDateProjection = substr_count($searchSource, $addedLine) === 1;
        $row = [
            'condition_date' => '2025-03-14 10:11:12',
            'last_updated_time' => '2025-03-15 12:13:14',
            'begdate' => '2025-02-01 08:09:10',
            'enddate' => '',
            'comments' => '',
            'diagnosis' => '',
            'title' => 'Synthetic health concern',
            'puuid' => 'synthetic-patient-reference',
            'occurrence' => 0,
            'outcome' => 0,
        ];
        // This emulates the selected columns; it does not execute SQL.
        if ($hasDateProjection) {
            $row['date'] = $row['condition_date'];
        }
        $explicit = $row;
        $explicit['date'] = '2025-03-14 10:11:12';
        $withoutDate = $explicit;
        unset($withoutDate['date']);
    } catch (\Throwable $error) {
        report([['name' => 'bootstrap', 'ok' => false, 'error' => $error->getMessage()]], 2);
    }

    $run('native_service_provenance', static function () use ($reflection, $service, $explicit): void {
        check($reflection->hasMethod('parseOpenEMRRecord'), 'native parser is missing');
        check($reflection->getMethod('parseOpenEMRRecord')->getDeclaringClass()->getName() === FhirConditionHealthConcernService::class, 'native parser is required');
        check($service->parseOpenEMRRecord($explicit) instanceof FHIRCondition, 'native FHIRCondition is required');
    });
    $run('approved_single_line_inverse', static function () use ($source, $legacyLine, $addedLine): void {
        same(1, substr_count($source, $legacyLine . $addedLine), 'exactly one complete approved insertion is required');
        $inverse = str_replace($legacyLine . $addedLine, $legacyLine, $source);
        same('bb87b37d1daf2653c7968cf1081759f2f68ea6da7efed7674b757037e43439ed', hash('sha256', $inverse), 'source must equal the supplied original after the single approved insertion is removed');
    });
    $run('legacy_condition_date_alias', static function () use ($searchSource, $legacyLine): void {
        same(1, substr_count($searchSource, $legacyLine), 'old SQL alias must remain once');
    });
    $run('date_alias_exactly_once', static function () use ($searchSource, $addedLine): void {
        same(1, substr_count($searchSource, $addedLine), 'new SQL alias must appear once');
    });
    $run('date_alias_immediately_after_legacy', static function () use ($searchSource, $legacyLine, $addedLine): void {
        same(1, substr_count($searchSource, $legacyLine . $addedLine), 'new alias must immediately follow the old alias');
    });
    $run('projected_creation_is_recorded_date', static function () use ($service, $row): void {
        same('2025-03-14T10:11:12+00:00', mapped($service, $row)['recordedDate'] ?? null, 'projected creation date');
    });
    $run('projected_creation_is_asserted_date', static function () use ($service, $row): void {
        same('2025-03-14T10:11:12+00:00', assertedDate(mapped($service, $row))['valueDateTime'] ?? null, 'projected asserted date');
    });
    $run('projected_onset_stays_distinct', static function () use ($service, $row): void {
        $document = mapped($service, $row);
        same('2025-02-01T08:09:10+00:00', $document['onsetDateTime'] ?? null, 'onset date');
        check(($document['recordedDate'] ?? null) !== ($document['onsetDateTime'] ?? null), 'creation and onset must differ');
    });
    $run('projected_json_matches_object', static function () use ($service, $row): void {
        same(mapped($service, $row), mapped($service, $row, true), 'native object and encoded branches');
    });
    $run('explicit_creation_recorded_date', static function () use ($service, $explicit): void {
        same('2025-03-14T10:11:12+00:00', mapped($service, $explicit)['recordedDate'] ?? null, 'direct row creation date');
    });
    $run('explicit_creation_asserted_extension', static function () use ($service, $explicit): void {
        same([
            'valueDateTime' => '2025-03-14T10:11:12+00:00',
            'url' => 'http://hl7.org/fhir/StructureDefinition/condition-assertedDate',
        ], assertedDate(mapped($service, $explicit)), 'direct row asserted extension');
    });
    $run('missing_date_uses_onset', static function () use ($service, $withoutDate): void {
        $document = mapped($service, $withoutDate);
        same('2025-02-01T08:09:10+00:00', $document['recordedDate'] ?? null, 'missing date fallback');
        same(null, assertedDate($document), 'missing date must have no asserted extension');
    });
    $run('null_date_uses_onset', static function () use ($service, $withoutDate): void {
        $row = $withoutDate;
        $row['date'] = null;
        $document = mapped($service, $row);
        same('2025-02-01T08:09:10+00:00', $document['recordedDate'] ?? null, 'null date fallback');
        same(null, assertedDate($document), 'null date must have no asserted extension');
    });
    $run('empty_date_omits_recorded_and_asserted', static function () use ($service, $explicit): void {
        $row = $explicit;
        $row['date'] = '';
        $document = mapped($service, $row);
        missing($document, 'recordedDate');
        same(null, assertedDate($document), 'empty date must have no asserted extension');
        same('2025-02-01T08:09:10+00:00', $document['onsetDateTime'] ?? null, 'onset remains present');
    });
    $run('no_creation_no_onset_omits_dates', static function () use ($service, $withoutDate): void {
        $row = $withoutDate;
        $row['begdate'] = null;
        $document = mapped($service, $row);
        missing($document, 'recordedDate');
        missing($document, 'onsetDateTime');
        same(null, assertedDate($document), 'no creation must have no asserted extension');
    });
    $run('input_row_is_not_mutated', static function () use ($service, $explicit): void {
        $before = $explicit;
        mapped($service, $explicit);
        same($before, $explicit, 'parser input');
    });
    $run('abatement_remains_independent', static function () use ($service, $explicit): void {
        $row = $explicit;
        $row['enddate'] = '2025-04-20 16:17:18';
        $document = mapped($service, $row);
        same('2025-04-20T16:17:18+00:00', $document['abatementDateTime'] ?? null, 'abatement');
        same('2025-02-01T08:09:10+00:00', $document['onsetDateTime'] ?? null, 'onset');
        same('2025-03-14T10:11:12+00:00', $document['recordedDate'] ?? null, 'creation');
    });

    $failed = count(array_filter($cases, static fn(array $case): bool => !$case['ok']));
    report($cases, $failed === 0 ? 0 : 1);
}
