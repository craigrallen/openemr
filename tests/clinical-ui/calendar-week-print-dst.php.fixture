    ['name' => 'year_rollover_four_row_cap', 'timezone' => 'UTC', 'dateYmd' => '20261227',
        'dates' => ['2026-12-27', '2026-12-28', '2026-12-29', '2026-12-30', '2026-12-31', '2027-01-01', '2027-01-02', '2027-01-03'],
        'left' => [['Sun', '12/27', 1], ['Mon', '12/28', 1], ['Tue', '12/29', 1], ['Wed', '12/30', 1]],
        'right' => [['Thu', '12/31', 4], ['Fri', '01/01', 5], ['Sat', '01/02', 6], ['Sun', '01/03', 7]]],
    ['name' => 'missing_right_date', 'timezone' => 'UTC', 'dateYmd' => '20260705',
        'dates' => ['2026-07-05', '2026-07-06', '2026-07-07', '2026-07-08', '2026-07-10', '2026-07-11'],
        'left' => [['Sun', '07/05', 1], ['Mon', '07/06', 1], ['Tue', '07/07', 1], ['Wed', '07/08', 1]],
        'right' => [null, ['Fri', '07/10', 4], ['Sat', '07/11', 5], null]],
    ['name' => 'invalid_date_fallback', 'timezone' => 'UTC', 'dateYmd' => '20260705',
        'dates' => ['not-a-date'], 'left' => [['', '', 0]], 'right' => [null]],
];

$results = [];
foreach ($cases as $case) {
    $timezoneBeforeCase = date_default_timezone_get();
    try {
        runCase($case);
        insist(date_default_timezone_get() === $timezoneBeforeCase, 'timezone not restored');
        $results[] = ['name' => $case['name'], 'status' => 'pass'];
    } catch (Throwable $error) {
        $results[] = ['name' => $case['name'], 'status' => 'fail', 'error' => $error->getMessage()];
    }
}
$passed = count(array_filter($results, static fn (array $case): bool => $case['status'] === 'pass'));
$failed = count($results) - $passed;
echo json_encode(['cases' => $results, 'total' => count($results), 'pass' => $passed, 'fail' => $failed], JSON_THROW_ON_ERROR), PHP_EOL;
exit($failed === 0 ? 0 : 1);
