    ['name' => 'leap_day', 'timezone' => 'UTC', 'dateYmd' => '20240225',
        'dates' => ['2024-02-25', '2024-02-26', '2024-02-27', '2024-02-28', '2024-02-29', '2024-03-01', '2024-03-02'],
        'left' => [['Sun', '02/25', 1], ['Mon', '02/26', 1], ['Tue', '02/27', 1], ['Wed', '02/28', 1]],
        'right' => [['Thu', '02/29', 4], ['Fri', '03/01', 5], ['Sat', '03/02', 6], null]],
