<?php

declare(strict_types=1);

// The native print event decorator calls only these escaping boundaries for
// the synthetic, non-patient events below.
function text(mixed $value): string
{
    return htmlspecialchars((string) $value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
}

function attr(mixed $value): string
{
    return htmlspecialchars((string) $value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
}

$root = dirname(__DIR__, 2);
require_once $root . '/src/PostCalendar/ViewModel/ViewType.php';
require_once $root . '/src/PostCalendar/ViewModel/CalendarViewModel.php';
require_once $root . '/src/Common/Assets/ClinicalWorkspaceAssets.php';
require_once $root . '/src/PostCalendar/ViewModel/CalendarRenderDataBuilder.php';

use OpenEMR\Common\Assets\ClinicalWorkspaceAssets;
use OpenEMR\PostCalendar\ViewModel\CalendarRenderDataBuilder;
use OpenEMR\PostCalendar\ViewModel\CalendarViewModel;
use OpenEMR\PostCalendar\ViewModel\ViewType;

function insist(bool $condition, string $message): void
{
    if (!$condition) {
        throw new RuntimeException($message);
    }
}

/** @param list<array{0: string, 1: string, 2: string}> $headings */
function runCase(array $spec): void
{
    $originalTimezone = date_default_timezone_get();
    try {
        date_default_timezone_set($spec['timezone']);
        $events = [];
        foreach ($spec['dates'] as $index => $date) {
            if ($date === 'not-a-date') {
                $events[$date] = [];
                continue;
            }
            $events[$date] = [[
                'eid' => 100 + $index,
                'aid' => 7,
                'catid' => 5,
                'catname' => 'Marker ' . $index,
                'startTime' => '09:00:00',
                'pid' => 0,
            ], [
                'eid' => 900 + $index,
                'aid' => 99,
                'catid' => 5,
                'catname' => 'Other provider',
                'startTime' => '09:00:00',
                'pid' => 0,
            ]];
        }
        $providers = [['id' => 7, 'fname' => 'Test', 'lname' => 'Provider']];
        $days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
        $beforeEvents = $events;
        $beforeProviders = $providers;
        $beforeDays = $days;
        $builder = new CalendarRenderDataBuilder(
            new CalendarViewModel(ViewType::WeekPrint, 0),
            new ClinicalWorkspaceAssets()
        );
        $result = $builder->buildWeekPrintRenderData(
            $events,
            $providers,
            $spec['dateYmd'],
            $days,
            0,
            '/synthetic-images'
        );
        insist($events === $beforeEvents && $providers === $beforeProviders && $days === $beforeDays, 'input arrays changed');
        insist(count($result['providers']) === 1, 'provider count');
        $provider = $result['providers'][0];
        insist($provider['id'] === 7, 'provider identity');
        $pairs = $provider['dayPairs'];
        insist(count($pairs) === count($spec['left']), 'row count or four-row cap');
        foreach ($spec['left'] as $row => $expected) {
            $left = $pairs[$row]['left'];
            insist([$left['weekdayLabel'], $left['dateMD']] === [$expected[0], $expected[1]], "left heading row {$row}");
            insist(count($left['events']) === $expected[2], "left event count row {$row}");
            if ($expected[2] === 1) {
                insist($left['events'][0]['eid'] === 100 + $row, "left event identity row {$row}");
                insist($left['events'][0]['eventDate'] === str_replace('-', '', $spec['dates'][$row]), "left event date row {$row}");
            }
            $right = $pairs[$row]['right'];
            $expectedRight = $spec['right'][$row];
            if ($expectedRight === null) {
                insist($right === null, "right should be absent row {$row}");
                continue;
            }
            insist(is_array($right), "right missing row {$row}");
            insist([$right['weekdayLabel'], $right['dateMD']] === [$expectedRight[0], $expectedRight[1]], "right heading row {$row}");
            insist(count($right['events']) === 1, "right event count row {$row}");
            insist($right['events'][0]['eid'] === 100 + $expectedRight[2], "right event identity row {$row}");
            insist($right['events'][0]['eventDate'] === str_replace('-', '', $spec['dates'][$expectedRight[2]]), "right event date row {$row}");
        }
    } finally {
        date_default_timezone_set($originalTimezone);
    }
}

$cases = [
    ['name' => 'stockholm_fall', 'timezone' => 'Europe/Stockholm', 'dateYmd' => '20261025',
        'dates' => ['2026-10-25', '2026-10-26', '2026-10-27', '2026-10-28', '2026-10-29', '2026-10-30', '2026-10-31'],
