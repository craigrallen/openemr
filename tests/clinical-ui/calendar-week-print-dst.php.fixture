    ['name' => 'stockholm_spring', 'timezone' => 'Europe/Stockholm', 'dateYmd' => '20260329',
        'dates' => ['2026-03-29', '2026-03-30', '2026-03-31', '2026-04-01', '2026-04-02', '2026-04-03', '2026-04-04'],
        'left' => [['Sun', '03/29', 1], ['Mon', '03/30', 1], ['Tue', '03/31', 1], ['Wed', '04/01', 1]],
        'right' => [['Thu', '04/02', 4], ['Fri', '04/03', 5], ['Sat', '04/04', 6], null]],
    ['name' => 'new_york_spring', 'timezone' => 'America/New_York', 'dateYmd' => '20260308',
        'dates' => ['2026-03-08', '2026-03-09', '2026-03-10', '2026-03-11', '2026-03-12', '2026-03-13', '2026-03-14'],
        'left' => [['Sun', '03/08', 1], ['Mon', '03/09', 1], ['Tue', '03/10', 1], ['Wed', '03/11', 1]],
        'right' => [['Thu', '03/12', 4], ['Fri', '03/13', 5], ['Sat', '03/14', 6], null]],
    ['name' => 'utc_no_dst', 'timezone' => 'UTC', 'dateYmd' => '20260705',
        'dates' => ['2026-07-05', '2026-07-06', '2026-07-07', '2026-07-08', '2026-07-09', '2026-07-10', '2026-07-11'],
