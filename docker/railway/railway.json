{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "docker/railway/Dockerfile"
    },
    "deploy": {
        "healthcheckPath": "/meta/railway/readyz",
        "healthcheckTimeout": 1800,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 5
    }
}
